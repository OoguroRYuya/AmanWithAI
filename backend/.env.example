# Salin menjadi backend/.env lalu sesuaikan. File .env tidak di-commit.

# --- Router VyOS (SSH, sisi NAT/host eth4) ---
ROUTER_HOST=192.168.42.198
ROUTER_USER=vyos
ROUTER_PASS=vyos

# true = perintah hanya dicatat di log, tidak dikirim ke router.
# Ubah ke false hanya setelah `ssh vyos@192.168.42.198` berhasil (fase 5).
DRY_RUN=true

# --- Ambang tingkat kepercayaan ---
# >= AMBANG_TINGGI -> mitigasi otomatis; AMBANG_SEDANG..AMBANG_TINGGI -> menunggu persetujuan
AMBANG_TINGGI=0.90
AMBANG_SEDANG=0.70

# --- Gerbang mitigasi per insiden (dipakai pipeline live, fase 2) ---
MIN_FLOW_INSIDEN=20
AMBANG_RASIO_SERANGAN=0.80

# --- Allowlist: tidak pernah diblokir (pisahkan dengan koma) ---
# Gateway VyOS tiap subnet, Collector, host backend (IP Windows dilihat dari VM GNS3)
ALLOWLIST=192.168.10.1,192.168.20.1,192.168.30.1,192.168.100.1,192.168.100.10,192.168.172.1
