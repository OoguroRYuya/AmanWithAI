# Salin menjadi backend/.env lalu sesuaikan. File .env tidak di-commit.

# --- Router VyOS (SSH, sisi NAT/host eth4) ---
ROUTER_HOST=192.168.42.198
ROUTER_USER=vyos
ROUTER_PASS=vyos

# true = perintah hanya dicatat di log, tidak dikirim ke router.
# Ubah ke false hanya setelah `ssh vyos@192.168.42.198` berhasil (fase 5).
DRY_RUN=true

# --- Ambang tingkat kepercayaan ---
# >= AMBANG_TINGGI -> mitigasi otomatis; AMBANG_SEDANG..AMBANG_TINGGI -> menunggu persetujuan
AMBANG_TINGGI=0.90
AMBANG_SEDANG=0.50

# --- Gerbang mitigasi per insiden (dipakai pipeline live, fase 2) ---
MIN_FLOW_INSIDEN=20
AMBANG_RASIO_SERANGAN=0.80
# Blokir otomatis bila sumber lolos gerbang rasio dan confidence rata-ratanya
# >= nilai ini; AMBANG_SEDANG..nilai ini -> menunggu persetujuan admin;
# di bawah AMBANG_SEDANG -> hanya dicatat
AMBANG_CONF_BLOKIR=0.70

# --- Allowlist: tidak pernah diblokir (pisahkan dengan koma) ---
# Gateway VyOS tiap subnet, Collector, host backend (IP Windows dilihat dari VM GNS3)
ALLOWLIST=192.168.10.1,192.168.20.1,192.168.30.1,192.168.100.1,192.168.100.10,192.168.172.1

# Lama pemblokiran otomatis (menit)
DURASI_BLOKIR_MENIT=15

# --- Pipeline live (fase 2) ---
# Flow menuju subnet ini = backscatter, dibuang sebelum klasifikasi
SUBNET_BACKSCATTER=192.168.20.0/24
# true = packet_count diestimasi dari byte_count (byte/84) seperti data latih
ESTIMASI_PAKET_PAKSA=false

# ingest = menunggu POST /api/ingest dari kirim_flow.sh; replay = putar ulang CSV
SUMBER=ingest
REPLAY_CSV=data/exp2/flows_sesi4.csv
REPLAY_INTERVAL_DETIK=3
# POST /api/ingest {"path": ...} hanya boleh membaca file di folder ini
INGEST_DIR=data

# --- Keamanan (security by design) ---
# Buat kedua nilai ini dengan:  cd backend; .venv\Scripts\python keamanan.py
# Kosong = fiturnya terkunci (tidak ada yang bisa masuk / ingest ditolak).
# DRY_RUN=false menolak start bila salah satunya kosong.
ADMIN_PASSWORD_HASH=
INGEST_TOKEN=

# Satu-satunya origin browser yang boleh memakai API dan WebSocket
ORIGIN_FRONTEND=http://localhost:3000
# Dari mana koneksi boleh datang (IP / CIDR, pisahkan dengan koma)
ADMIN_SUMBER=127.0.0.1,::1
INGEST_SUMBER=127.0.0.1,::1,192.168.172.0/24
SESI_IDLE_MENIT=30
SESI_MAKS_JAM=8
INGEST_MAKS_MB=20

# Sumber di subnet ini tidak pernah diblokir otomatis (hanya lewat persetujuan):
# alamat klien/server sah bisa dipalsukan penyerang dalam flood
SUBNET_TERLINDUNG=192.168.10.0/24,192.168.30.0/24
# Pemutus darurat: lebih dari ini IP baru per jendela -> dialihkan ke persetujuan
MAKS_BLOKIR_BARU_PER_JENDELA=300
# Daftar IP terblokir disimpan di sini agar tidak hilang saat restart
DIR_STATUS=backend/.state

# --- Login router dengan kunci SSH (disarankan sebelum DRY_RUN=false) ---
# Bila diisi, ROUTER_PASS tidak dipakai. Menyiapkannya (sekali):
#   1. Windows: ssh-keygen -t ed25519 -f %USERPROFILE%\.ssh\ndr_vyos -N ""
#   2. VyOS (configure): set system login user vyos authentication public-keys ndr type ssh-ed25519
#                        set system login user vyos authentication public-keys ndr key <isi base64 dari ndr_vyos.pub>
#                        commit; save
#   3. Uji: ssh -i %USERPROFILE%\.ssh\ndr_vyos vyos@192.168.42.198
ROUTER_KEY_FILE=
