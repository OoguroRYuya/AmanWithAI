# Salin menjadi backend/.env lalu sesuaikan. File .env tidak di-commit.

# --- Router VyOS (SSH, sisi NAT/host eth4) ---
ROUTER_HOST=192.168.42.198
ROUTER_USER=vyos
ROUTER_PASS=vyos

# true = perintah hanya dicatat di log, tidak dikirim ke router.
# Ubah ke false hanya setelah `ssh vyos@192.168.42.198` berhasil (fase 5).
DRY_RUN=true

# --- Ambang tingkat kepercayaan ---
# >= AMBANG_TINGGI -> mitigasi otomatis; AMBANG_SEDANG..AMBANG_TINGGI -> menunggu persetujuan
AMBANG_TINGGI=0.90
AMBANG_SEDANG=0.50

# --- Gerbang mitigasi per insiden (dipakai pipeline live, fase 2) ---
MIN_FLOW_INSIDEN=20
AMBANG_RASIO_SERANGAN=0.80
# Blokir otomatis bila sumber lolos gerbang rasio dan confidence rata-ratanya
# >= nilai ini; AMBANG_SEDANG..nilai ini -> menunggu persetujuan admin;
# di bawah AMBANG_SEDANG -> hanya dicatat
AMBANG_CONF_BLOKIR=0.70

# --- Allowlist: tidak pernah diblokir (pisahkan dengan koma) ---
# Gateway VyOS tiap subnet, Collector, host backend (IP Windows dilihat dari VM GNS3)
ALLOWLIST=192.168.10.1,192.168.20.1,192.168.30.1,192.168.100.1,192.168.100.10,192.168.172.1

# Lama pemblokiran otomatis (menit)
DURASI_BLOKIR_MENIT=15

# --- Pipeline live (fase 2) ---
# Flow menuju subnet ini = backscatter, dibuang sebelum klasifikasi
SUBNET_BACKSCATTER=192.168.20.0/24
# true = packet_count diestimasi dari byte_count (byte/84) seperti data latih
ESTIMASI_PAKET_PAKSA=false

# ingest = menunggu POST /api/ingest dari kirim_flow.sh; replay = putar ulang CSV
SUMBER=ingest
REPLAY_CSV=data/exp2/flows_sesi4.csv
REPLAY_INTERVAL_DETIK=3
# POST /api/ingest {"path": ...} hanya boleh membaca file di folder ini
INGEST_DIR=data
